def get_menu_links(url):
    options = Options()
    options.headless = True  # 无头模式
    driver = webdriver.Chrome(options=options)
    driver.get(url)
    
    # 等待菜单加载（可根据实际情况调整）
    driver.implicitly_wait(5)  
    
    soup = BeautifulSoup(driver.page_source, 'html.parser')
    driver.quit()

    menu_container = soup.find('ul', {'id': 'common-menu-container'})
    if not menu_container:
        print("Selenium 也未找到菜单，可能需要更长的等待或检查选择器")
        return []
    
    wait = WebDriverWait(driver, 10)
    menu = wait.until(EC.presence_of_element_located((By.ID, 'common-menu-container')))


    links = []
    for a_tag in menu_container.find_all('a', href=True):
        href = a_tag['href']
        text = a_tag.get_text().strip()
        if href and not href.startswith(('javascript', '#')):
            absolute_url = urljoin(url, href)
            links.append(absolute_url)
            print(f"找到菜单项: {text} -> {absolute_url}")
    return links



